<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C8D3E4"
    tools:context=".MainActivity">

    <!-- SNAKE -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSnake"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:clipToOutline="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardBrickGame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ico_snake"
            android:scaleType="centerCrop"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- BRICK GAME -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBrickGame"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:clipToOutline="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"

        app:layout_constraintTop_toBottomOf="@id/cardSnake"
        app:layout_constraintBottom_toTopOf="@id/cardTicTacToe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ico_brickgame"
            android:scaleType="centerCrop"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- TIC TAC TOE -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTicTacToe"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:clipToOutline="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"

        app:layout_constraintTop_toBottomOf="@id/cardBrickGame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ico_ttt" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>